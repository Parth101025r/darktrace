# Copy to .env and fill in only the values needed by the service you run.
# NEVER commit .env to git.
# Development API: Redis must be running at this URL.
REDIS_URL=redis://localhost:6379
ALERTS_KEY=darktrace:alerts
ALERT_ID_KEY=darktrace:alerts:next_id

# Standalone JWT demo: PostgreSQL must be available at this URL.
# Railway: Postgres service -> Variables/Connect -> copy "DATABASE_PUBLIC_URL"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 32+ random characters; generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=darktrace
